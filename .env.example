BOT_TOKEN=123456:telegram-bot-token
CHANNEL_ID=@questguiderf_channel
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_API_TOKEN=your-cloudflare-api-token
CF_MODEL=@cf/meta/llama-3.1-8b-instruct
GITHUB_REPO=your-org/questguiderf
DATABASE_URL=sqlite+aiosqlite:///./storage/app.db
LOG_LEVEL=INFO
TELEGRAM_ADMIN_IDS=123456789
AUTO_FETCH_ENABLED=true
AUTO_FETCH_CRON=*/30 * * * *
MAX_SOURCE_ITEMS=10
NOTES_STORAGE_PATH=storage/notes/inbox.md
WEBSITE_SOURCES=https://example.com/travel-news,https://example.com/city-walks
TELEGRAM_SOURCE_URLS=https://t.me/s/example_channel
PUBLISH_PREVIEW_ENABLED=true